# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosting URL injected by AI Studio; canonical SEO URLs use SITE_URL.
APP_URL="MY_APP_URL"

# MONGODB_URI: Required MongoDB Atlas connection string; JSON/local storage is disabled.
# One-time import: npm run db:migrate-json -- --backup-dir <absolute-path-outside-repository>
SITE_URL="https://24selfdrive.com"
MONGODB_URI=

# ADMIN_EMAIL: Optional preset admin login email (or configure via /admin first-run setup).
ADMIN_EMAIL=

# ADMIN_PASSWORD: Optional preset admin login password (never stored in client code).
ADMIN_PASSWORD=
